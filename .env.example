# Copy to .env and edit. .env is git-ignored.

# --- Vision worker ---
# Comma-separated: phone via MediaMTX, fake cameras, or plain video files.
CAMERA_SOURCES=rtsp://localhost:8554/cam1
# CAMERA_SOURCES=rtsp://localhost:8554/cam1,rtsp://localhost:8554/cam2,rtsp://localhost:8554/cam3,rtsp://localhost:8554/cam4

MODEL_PATH=models/rfdetr-nano.onnx
# GPU = Intel iGPU via OpenVINO, CPU = OpenVINO on CPU, CPU-ONLY = ONNX Runtime (portable fallback)
INFERENCE_DEVICE=GPU
INFERENCE_FPS=3
DETECTION_CONFIDENCE=0.40
DETECT_CLASSES=person,bicycle,car,motorcycle,bus,truck
EVENT_STORAGE_PATH=storage/events

# --- API ---
# Generate: cd services/backend; uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CAMERA_SECRET_KEY=replace_with_fernet_key
# Generate: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_TOKEN=replace_with_random_token
# Worker: set to use the API for cameras/events; leave empty for standalone mode (CAMERA_SOURCES + files)
# Use 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 first and stalls.
API_BASE_URL=http://127.0.0.1:8000

# --- Database (docker compose up -d) ---
POSTGRES_DB=aivision
POSTGRES_USER=aivision
POSTGRES_PASSWORD=replace_with_a_long_random_password
